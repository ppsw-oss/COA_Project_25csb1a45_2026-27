    <comp lib="8" loc="(280,100)" name="Text"><a name="text" val="INPUTS"/><a name="font" val="SansSerif bold 14"/></comp>
    <comp lib="8" loc="(280,120)" name="Text"><a name="text" val="Set switches, pulse START. RESET = async clear."/><a name="font" val="SansSerif plain 11"/></comp>
    <comp lib="8" loc="(760,100)" name="Text"><a name="text" val="DECODERS / COMPARATORS"/><a name="font" val="SansSerif bold 14"/></comp>
    <comp lib="8" loc="(760,120)" name="Text"><a name="text" val="EQ against constants decodes STATE; GT/LT test thresholds."/><a name="font" val="SansSerif plain 11"/></comp>
    <comp lib="8" loc="(1240,100)" name="Text"><a name="text" val="PARAMETER LOOK-UP (MUX)"/><a name="font" val="SansSerif bold 14"/></comp>
    <comp lib="8" loc="(1240,120)" name="Text"><a name="text" val="fabric/load/water -&gt; constants via 2:1 mux chains."/><a name="font" val="SansSerif plain 11"/></comp>
    <comp lib="8" loc="(1720,100)" name="Text"><a name="text" val="CYCLE-TIME ARITHMETIC"/><a name="font" val="SansSerif bold 14"/></comp>
    <comp lib="8" loc="(1720,120)" name="Text"><a name="text" val="wash = base + 2*load + 4*soil; rinse = 2*water+2; spin = base+load."/><a name="font" val="SansSerif plain 11"/></comp>
    <comp lib="8" loc="(2200,100)" name="Text"><a name="text" val="CONTROL EVENTS (MUX LOGIC)"/><a name="font" val="SansSerif bold 14"/></comp>
    <comp lib="8" loc="(2200,120)" name="Text"><a name="text" val="go_wash = IDLE&amp;START; stage ends = state&amp;timer==0."/><a name="font" val="SansSerif plain 11"/></comp>
    <comp lib="8" loc="(2680,100)" name="Text"><a name="text" val="CONFIG LATCH (frozen at START)"/><a name="font" val="SansSerif bold 14"/></comp>
    <comp lib="8" loc="(2680,120)" name="Text"><a name="text" val="Registers load every tick in IDLE, hold while running (WE=IDLE)."/><a name="font" val="SansSerif plain 11"/></comp>
    <comp lib="8" loc="(3160,100)" name="Text"><a name="text" val="UNBALANCE GUARD + FAULT"/><a name="font" val="SansSerif bold 14"/></comp>
    <comp lib="8" loc="(3160,120)" name="Text"><a name="text" val="Pre-spin + in-spin check; max 2 REBAL then FAULT."/><a name="font" val="SansSerif plain 11"/></comp>
    <comp lib="8" loc="(3640,100)" name="Text"><a name="text" val="NEXT-STATE / NEXT-TIMER"/><a name="font" val="SansSerif bold 14"/></comp>
    <comp lib="8" loc="(3640,120)" name="Text"><a name="text" val="Priority chain: later mux wins (abort &gt; rebal &gt; end ...)."/><a name="font" val="SansSerif plain 11"/></comp>
    <comp lib="8" loc="(4120,100)" name="Text"><a name="text" val="RESOURCE METER + BASELINE"/><a name="font" val="SansSerif bold 14"/></comp>
    <comp lib="8" loc="(4120,120)" name="Text"><a name="text" val="ticks, energy (3/1/2/1 per tick), water; compare to 49/112/16."/><a name="font" val="SansSerif plain 11"/></comp>
    <comp lib="8" loc="(4600,100)" name="Text"><a name="text" val="STATE REGISTERS"/><a name="font" val="SansSerif bold 14"/></comp>
    <comp lib="8" loc="(4600,120)" name="Text"><a name="text" val="Async RESET clears all. WE tied 1 (latch regs use WE=IDLE)."/><a name="font" val="SansSerif plain 11"/></comp>
    <comp lib="8" loc="(5080,100)" name="Text"><a name="text" val="OUTPUTS"/><a name="font" val="SansSerif bold 14"/></comp>
    <comp lib="8" loc="(5080,120)" name="Text"><a name="text" val="SAVED outputs valid at END only."/><a name="font" val="SansSerif plain 11"/></comp>
    <comp lib="8" loc="(100,20)" name="Text"><a name="text" val="Smart Washing Machine Control and Cycle Management System  |  Palak (25CSB1A45)  |  COA EC1263  |  Logisim Evolution 4.1.0  |  FIXED/audited build"/><a name="font" val="SansSerif bold 16"/></comp>
    <comp lib="8" loc="(100,50)" name="Text"><a name="text" val="Features: closed-loop turbidity feedback (ADAPT_EN) + unbalance guard with bounded REBAL retries and FAULT (BAL_EN) + resource meter vs fixed-cycle baseline.  Enable ticks: Ctrl+K."/><a name="font" val="SansSerif plain 12"/></comp>
    <comp lib="8" loc="(100,70)" name="Text"><a name="text" val="Ablation: FIXED_CYCLE=1 -&gt; B0 baseline | FIXED=0,ADAPT=0,BAL=0 -&gt; B1 | +ADAPT_EN/+BAL_EN -&gt; B2.  Fabric 0=cotton 1=synthetic 2=delicate 3=heavy.  States: 0 IDLE 1 WASH 2 RINSE 3 SPIN 4 END 5 REBAL (6,7 recover to IDLE)."/><a name="font" val="SansSerif plain 12"/></comp>
